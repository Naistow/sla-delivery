// ============================================================================
// Методичка 6: Код для 1С:Предприятие 8.3 (Тема 11: Контроль SLA доставки)
// Справочник: Справочники.ЗоныДоставки
// Реквизиты справочника:
//   - Код (Строка, длина 32)
//   - Наименование (Строка, длина 128)
//   - НормативМин (Число, длина 10, точность 0)
//   - КритОпозданиеМин (Число, длина 10, точность 0)
// ============================================================================

// 1. Выгрузка справочника ЗоныДоставки из 1С в CSV (exchange/spravochnik_zon.csv)
&НаСервере
Процедура ВыгрузитьЗоныДоставкиНаСервере()
    Текст = Новый ТекстовыйДокумент;
    Текст.ДобавитьСтроку("Код;Наименование;НормативМин;КритОпозданиеМин");
    Выборка = Справочники.ЗоныДоставки.Выбрать();
    Пока Выборка.Следующий() Цикл
        СтрокаДанных = СокрЛП(Выборка.Код) + ";"
            + СокрЛП(Выборка.Наименование) + ";"
            + Формат(Выборка.НормативМин, "ЧГ=0") + ";"
            + Формат(Выборка.КритОпозданиеМин, "ЧГ=0");
        Текст.ДобавитьСтроку(СтрокаДанных);
    КонецЦикла;
    Текст.Записать(ПутьКФайлуВыгрузки, КодировкаТекста.UTF8);
КонецПроцедуры

// 2. Загрузка сводки SLA из CSV (exchange/svodka_sla_dlya_1c.csv) в ТабличныйДокумент и регистр сведений
&НаСервере
Процедура ПрочитатьСводкуSLAНаСервере(ТабДок)
    Текст = Новый ТекстовыйДокумент;
    Текст.Прочитать(ПутьКФайлуСводки, КодировкаТекста.UTF8);
    Для Н = 2 По Текст.КоличествоСтрок() Цикл
        Стр = СокрЛП(Текст.ПолучитьСтроку(Н));
        Если ПустаяСтрока(Стр) Тогда
            Продолжить;
        КонецЕсли;
        Части = СтрРазделить(Стр, ";", Истина);
        Если Части.Количество() >= 8 Тогда
            КодЗоны          = Части[0];
            НаименованиеЗоны = Части[1];
            ВсегоДоставок    = Число(Части[2]);
            ВСрок            = Число(Части[3]);
            НарушенийSLA     = Число(Части[4]);
            ПроцентSLA       = ?(ПустаяСтрока(Части[5]), 0, Число(Части[5]));
            СреднееВремяМин  = ?(ПустаяСтрока(Части[6]), 0, Число(Части[6]));
            МаксОпозданиеМин = ?(ПустаяСтрока(Части[7]), 0, Число(Части[7]));
            // Вывод строки в отчет 1С или запись в РегистрыСведений.ПоказателиSLAДоставки
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

// 3. HTTP-сервис 1С (корневой URL: zones, шаблон: /list, метод: GET)
Функция СписокЗонGET(Запрос)
    Запись = Новый ЗаписьJSON;
    Запись.УстановитьСтроку();
    Запись.ЗаписатьНачалоМассива();
    Выборка = Справочники.ЗоныДоставки.Выбрать();
    Пока Выборка.Следующий() Цикл
        Запись.ЗаписатьНачалоОбъекта();
        Запись.ЗаписатьИмяСвойства("code");
        Запись.ЗаписатьЗначение(СокрЛП(Выборка.Код));
        Запись.ЗаписатьИмяСвойства("name");
        Запись.ЗаписатьЗначение(СокрЛП(Выборка.Наименование));
        Запись.ЗаписатьИмяСвойства("sla_target_min");
        Запись.ЗаписатьЗначение(Выборка.НормативМин);
        Запись.ЗаписатьИмяСвойства("max_delay_min");
        Запись.ЗаписатьЗначение(Выборка.КритОпозданиеМин);
        Запись.ЗаписатьКонецОбъекта();
    КонецЦикла;
    Запись.ЗаписатьКонецМассива();
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8");
    Возврат Ответ;
КонецФункции
